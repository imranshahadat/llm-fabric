.env.example.

# ---- Active LLM & Embedding Selection ----------------------------------------
LLM_PROVIDER="vercel"
LLM_MODEL="emini-3.1-flash-lite"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=3000
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=3
LLM_ANNOUNCE=true

EMBEDDING_PROVIDER="vercel"
EMBEDDING_MODEL="cohere/embed-v4.0"
EMBEDDING_DIMENSIONS="1024"

# ---- Google Gemini -----------------------------------------------------------
GEMINI_API_KEY="AQ."
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# ---- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_ORGANIZATION=""

# ---- OpenRouter (OpenAI-compatible gateway) ----------------------------------
OPENROUTER_API_KEY="sk-or-v1-"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_SITE_URL="https://example.com"
OPENROUTER_APP_NAME="project6-1"

# ---- Vercel AI Gateway -------------------------------------------------------
VERCEL_API_KEY=""
VERCEL_BASE_URL="https://ai-gateway.vercel.sh/v1"
VERCEL_MODEL="openai/gpt-4o-mini"
VERCEL_EMBEDDING_MODEL=""

# ---- Cohere ------------------------------------------------------------------
COHERE_API_KEY=""
CO_API_URL="https://api.cohere.com/v2"
COHERE_EMBED_MODELS="embed-v5.0-fast"
COHERE_RERANK_MODELS="rerank-v5.0-fast"

# ---- Chunking, Retrieval & Reranking ----------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DEFAULT_RETRIEVAL_K=4
HYBRID_FETCH_K=20
SIMILARITY_THRESHOLD=0.10
USE_RERANKER=true
RERANKER_MODEL=""

# ---- Metadata Filtering -------------------------------------------------------
# Comma-separated allowlist of payload fields that may be filtered on.
METADATA_FILTER_FIELDS="source,file_type,kind,page"

# ---- Semantic Cache (Redis / Redis Cloud) ------------------------------------
CACHE_ENABLED=true
CACHE_PROVIDER="redis"
# Local: redis://localhost:6379/0  |  Redis Cloud: rediss://default:<password>@<host>:<port>
REDIS_URL="redis://localhost:6379/0"
CACHE_NAMESPACE="semcache"
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_ENTRIES_PER_SCOPE=128

# ---- Query Summarizer (small LLM, saves tokens on long queries) --------------
QUERY_SUMMARIZER_ENABLED=true
# Empty = reuse LLM_MODEL; set a cheap model here, e.g. "gemini-1.5-flash-8b"
SUMMARIZER_MODEL="gemini-1.5-flash-8b"
SUMMARIZER_MAX_TOKENS=120
SUMMARIZER_MIN_QUERY_WORDS=12
SUMMARIZER_MAX_WORDS=30

# ---- Guardrails & Chat -------------------------------------------------------
GUARDRAILS_ENABLED=true
GUARDRAILS_PARALLEL=true
INPUT_GUARDS=pii,injection,toxicity
OUTPUT_GUARDS=pii,system_prompt_leak
PII_BLOCK_INPUT=false
PII_BLOCK_OUTPUT=true
TOXICITY_BANNED_WORDS=""

CHAT_HISTORY_TURNS=6
CHAT_REWRITE_FOLLOWUP=true
CHAT_MAX_ANSWER_CHARS=2000
CHAT_NO_EVIDENCE_MSG="kfdlfdldfndle documents."
ACCESS_CONTROL_ENABLED=false

# ---- Pinecone Vector Database ------------------------------------------------
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="rag-knowledge-base4627b74apinecone"
PINECONE_NAMESPACE=""
PINECONE_ENVIRONMENT=""
PINECONE_DIMENSION=1024
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"
PINECONE_READ_TIMEOUT=180

# ---- Neon PostgreSQL Database ------------------------------------------------
DATABASE_URL="postgresql://QCo@ep-noisy-poetry--pooler.c-2utheast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---- AWS S3 & Credentials ----------------------------------------------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY="/3BBJnvtR"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME="imranali-"

# ---- Tracing & Security ------------------------------------------------------
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
JWT_SECRET_KEY="="